--- /dev/null
+++ b/billing/formatting.py
@@ -0,0 +1,6 @@
+def describe_customer(customer):
+    return f"{customer.full_name} <{customer.contact}>"
+
+
+def describe_amount(amount, currency):
+    return f"{amount:.2f} {currency}"
