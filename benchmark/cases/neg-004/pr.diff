@@ -0,0 +1,11 @@
+import { Request, Response } from "express";
+import { prisma } from "../db";
+
+export async function health(_req: Request, res: Response) {
+  try {
+    await prisma.$queryRaw`SELECT 1`;
+    res.json({ status: "ok" });
+  } catch {
+    res.status(503).json({ status: "db_unavailable" });
+  }
+}
