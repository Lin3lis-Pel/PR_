diff --git a/integrations/crm.py b/integrations/crm.py
new file mode 100644
--- /dev/null
+++ b/integrations/crm.py
@@ -0,0 +1,20 @@
+import requests
+from django.conf import settings
+
+CRM_CONTACTS_URL = "https://api.relatecrm.example/v2/contacts"
+
+
+def sync_customer(customer):
+    payload = {
+        "external_id": str(customer.pk),
+        "name": customer.display_name,
+        "email": customer.user.email,
+        "phone": customer.phone_number,
+    }
+    response = requests.post(
+        CRM_CONTACTS_URL,
+        json=payload,
+        headers={"Authorization": f"Bearer {settings.CRM_API_KEY}"},
+        timeout=10,
+    )
+    response.raise_for_status()
