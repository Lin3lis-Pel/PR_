diff --git a/src/main/java/com/acme/shop/analytics/AnalyticsIdentity.java b/src/main/java/com/acme/shop/analytics/AnalyticsIdentity.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/com/acme/shop/analytics/AnalyticsIdentity.java
@@ -0,0 +1,30 @@
+package com.acme.shop.analytics;
+
+import java.nio.charset.StandardCharsets;
+import java.security.GeneralSecurityException;
+import java.util.HexFormat;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+@Component
+public class AnalyticsIdentity {
+
+    private final SecretKeySpec key;
+
+    public AnalyticsIdentity(@Value("${analytics.identity-secret}") String secret) {
+        this.key = new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256");
+    }
+
+    public String subjectFor(String email) {
+        try {
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(key);
+            byte[] digest = mac.doFinal(email.trim().toLowerCase().getBytes(StandardCharsets.UTF_8));
+            return HexFormat.of().formatHex(digest);
+        } catch (GeneralSecurityException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
