diff --git a/src/main/java/com/acme/shop/invoice/InvoiceTotals.java b/src/main/java/com/acme/shop/invoice/InvoiceTotals.java
--- a/src/main/java/com/acme/shop/invoice/InvoiceTotals.java
+++ b/src/main/java/com/acme/shop/invoice/InvoiceTotals.java
@@ -1,15 +1,19 @@
 package com.acme.shop.invoice;
 
 import java.math.BigDecimal;
+import java.math.RoundingMode;
 import java.util.List;
 
 public class InvoiceTotals {
 
     public BigDecimal net(List<InvoiceLine> lines) {
-        BigDecimal total = BigDecimal.ZERO;
-        for (InvoiceLine line : lines) {
-            total = total.add(line.price().multiply(BigDecimal.valueOf(line.quantity())));
-        }
-        return total;
+        return lines.stream()
+                .map(line -> line.price().multiply(BigDecimal.valueOf(line.quantity())))
+                .reduce(BigDecimal.ZERO, BigDecimal::add)
+                .setScale(2, RoundingMode.HALF_EVEN);
+    }
+
+    public BigDecimal vat(List<InvoiceLine> lines, BigDecimal rate) {
+        return net(lines).multiply(rate).setScale(2, RoundingMode.HALF_EVEN);
     }
 }
