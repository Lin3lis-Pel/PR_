new file mode 100644
--- /dev/null
+++ b/src/delivery/geocode.ts
@@ -0,0 +1,18 @@
+const GEOCODER_URL = "https://geo.mapfinder.example/v1/geocode";
+
+export interface Address {
+  recipientName: string;
+  line1: string;
+  postcode: string;
+  city: string;
+}
+
+export async function geocode(address: Address): Promise<{ lat: number; lng: number }> {
+  const query = `${address.line1}, ${address.postcode} ${address.city}`;
+  const url = `${GEOCODER_URL}?q=${encodeURIComponent(query)}&key=${process.env.GEOCODER_KEY}`;
+  const response = await fetch(url);
+  if (!response.ok) {
+    throw new Error(`geocoder returned ${response.status}`);
+  }
+  return response.json();
+}
