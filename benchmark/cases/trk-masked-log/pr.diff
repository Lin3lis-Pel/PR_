diff --git a/core/masking.py b/core/masking.py
new file mode 100644
--- /dev/null
+++ b/core/masking.py
@@ -0,0 +1,5 @@
+def mask_email(email):
+    local, _, domain = email.partition("@")
+    if not domain:
+        return "***"
+    return f"{local[:1]}***@{domain}"
