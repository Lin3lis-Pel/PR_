new file mode 100644
--- /dev/null
+++ b/src/orders/status.ts
@@ -0,0 +1,10 @@
+export enum OrderStatus {
+  New = "new",
+  Paid = "paid",
+  Shipped = "shipped",
+  Cancelled = "cancelled",
+}
+
+export function canCancel(status: OrderStatus): boolean {
+  return status === OrderStatus.New || status === OrderStatus.Paid;
+}
