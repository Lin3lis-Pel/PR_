   const order = await prisma.order.findUniqueOrThrow({ where: { id: orderId } });
-  if (order.status !== "new" && order.status !== "paid") {
-    throw new Error("cannot cancel");
+  if (!canCancel(order.status as OrderStatus)) {
+    throw new OrderStateError(order.id, order.status);
   }
-  return prisma.order.update({ where: { id: orderId }, data: { status: "cancelled" } });
+  return prisma.order.update({
+    where: { id: orderId },
+    data: { status: OrderStatus.Cancelled },
+  });
 }
 
 export function orderTotal(lines: { price: number; quantity: number }[]) {
-  let total = 0;
-  for (const line of lines) {
-    total += line.price * line.quantity;
-  }
-  return Math.round(total * 100) / 100;
+  return lines.reduce((sum, line) => sum + lineTotal(line), 0);
 }
