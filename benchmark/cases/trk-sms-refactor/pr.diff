new file mode 100644
--- /dev/null
+++ b/src/main/java/com/acme/shop/notify/SmsGateway.java
@@ -0,0 +1,20 @@
+package com.acme.shop.notify;
+
+import com.twilio.rest.api.v2010.account.Message;
+import com.twilio.type.PhoneNumber;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+@Component
+public class SmsGateway {
+
+    private final String sender;
+
+    public SmsGateway(@Value("${sms.sender}") String sender) {
+        this.sender = sender;
+    }
+
+    public void send(String phone, String text) {
+        Message.creator(new PhoneNumber(phone), new PhoneNumber(sender), text).create();
+    }
+}
