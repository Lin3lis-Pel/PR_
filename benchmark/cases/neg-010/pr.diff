@@ -0,0 +1,20 @@
+import { prisma } from "../db";
+
+const WAREHOUSE_URL = "https://api.stockhub.example/v1/levels";
+
+export async function syncStock() {
+  const levels = await prisma.inventory.findMany({
+    select: { sku: true, quantity: true },
+  });
+  const response = await fetch(WAREHOUSE_URL, {
+    method: "PUT",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${process.env.STOCKHUB_TOKEN}`,
+    },
+    body: JSON.stringify({ levels }),
+  });
+  if (!response.ok) {
+    throw new Error(`stock sync failed: ${response.status}`);
+  }
+}
