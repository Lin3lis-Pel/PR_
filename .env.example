# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Which model the reviewer uses. Change these two lines to switch models; no code changes.
# Model ID in OpenRouter's provider/model form, e.g. xiaomi/mimo-v2.6-pro
GDPR_REVIEWER_MODEL=xiaomi/mimo-v2.6-pro
# Upstream provider to pin (OpenRouter provider slug). Empty = let OpenRouter choose.
GDPR_REVIEWER_PROVIDER=xiaomi

# Tracing (from Step 6)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GitHub (from Step 6; the Action gets this automatically)
GITHUB_TOKEN=
